# --- Secrets (never commit) ---
.env
.env.*
!.env.example
*.pem
*.key
*.jks
*.keystore
google-services.json
service-account*.json

# --- Dependencies ---
node_modules/

# --- Build output ---
dist/
build/
.turbo/
# Prisma client output (regenerated by `prisma generate`)
apps/api/generated/
*.tsbuildinfo

# --- Expo / React Native ---
.expo/
.expo-shared/
web-build/
# Native folders are generated by `expo prebuild`; regenerate instead of committing
apps/mobile/android/
apps/mobile/ios/
*.apk
*.aab

# --- Local database / storage ---
pgdata/
postgres-data/
*.sqlite
*.sqlite3
*.db
local-uploads/

# --- Logs and test output ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
coverage/
.nyc_output/

# --- Evaluation and load-test output (keep the datasets and scripts, not the results) ---
eval/results/
k6-results/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp

# --- Claude Code local settings (keep CLAUDE.md committed) ---
.claude/settings.local.json