# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (local Docker in dev, Neon with sslmode=require in production)
DATABASE_URL=

# AWS Cognito (region eu-central-1)
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# OpenAI API key (backend only)
OPENAI_API_KEY=

# Optional, defaults to 3000
PORT=
