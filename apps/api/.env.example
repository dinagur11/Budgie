# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string (local Docker in dev, Neon with sslmode=require in production)
DATABASE_URL=

AWS_REGION=

# AWS credentials of the IAM user with only the receipts policy. Needed on Railway (no AWS role);
# locally they can come from your AWS profile instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# AWS Cognito 
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# AWS RECEIPTS
S3_BUCKET=

# OpenAI API 
OPENAI_API_KEY=
OPENAI_RECEIPT_MODEL=

# Optional, defaults to 3000
PORT=
