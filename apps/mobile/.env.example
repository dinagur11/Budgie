# Copy to .env and fill in (never commit .env). Read at build time by Expo (EXPO_PUBLIC_ values are bundled into the app, so never put secrets here).
# Android emulator: the host machine is http://10.0.2.2:<port>; a physical device needs the computer's LAN IP.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_COGNITO_USER_POOL_ID=
EXPO_PUBLIC_COGNITO_CLIENT_ID=
# Optional: EXPO_PUBLIC_FIXTURES=true runs the app on built-in fake data with no API or Cognito (screenshots, UI work). Never set it for a real build.
